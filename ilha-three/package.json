{
  "name": "ilha-tree",
  "version": "0.1.0",
  "description": "Three.js renderer bindings for ilha (react-three-fiber parity on ilha PaintOps + atoms)",
  "keywords": [
    "effect",
    "ilha",
    "three.js",
    "webgl",
    "renderer",
    "jsx"
  ],
  "homepage": "https://github.com/ilhajs/ilha#readme",
  "bugs": {
    "url": "https://github.com/ilhajs/ilha/issues"
  },
  "license": "MIT",
  "author": "Ryuz <ryuzer@proton.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilhajs/ilha.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./catalogue": {
      "types": "./dist/catalogue.d.ts",
      "import": "./dist/catalogue.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "cleanup": "rimraf dist node_modules",
    "example": "bun example/serve.ts",
    "example:build": "bun example/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.4",
    "@types/three": "^0.187.0",
    "@typescript/typescript-linux-x64": "^7.0.2",
    "effect": "^4.1.0",
    "ilha": "file:../ilha/packages/ilha",
    "rimraf": "^6.1.3",
    "three": "0.187.0",
    "tsdown": "^0.23.3",
    "typescript": "^7"
  },
  "peerDependencies": {
    "effect": "^4.1.0",
    "ilha": ">=0.16.3",
    "three": ">=0.180.0"
  }
}
