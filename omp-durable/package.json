{
  "name": "omp-durable",
  "version": "0.1.0",
  "description": "oh-my-pi harness features on pi-durable: full AgentSession-parity runs with durable execution on any pi-durable Storage (local SQLite, Cloudflare Durable Objects)",
  "keywords": ["oh-my-pi", "omp", "pi-durable", "agents", "durable-execution", "cloudflare"],
  "homepage": "https://github.com/ryuzcorp/labs#readme",
  "bugs": {
    "url": "https://github.com/ryuzcorp/labs/issues"
  },
  "license": "MIT",
  "author": "Ryuz <ryuzer@proton.me>",
  "repository": {
    "type": "git+https://github.com/ryuzcorp/labs.git"
  },
  "files": ["dist"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage/do": {
      "types": "./dist/storage/do.d.ts",
      "import": "./dist/storage/do.js"
    },
    "./storage/local": {
      "types": "./dist/storage/local.d.ts",
      "import": "./dist/storage/local.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:worker": "bun worker/build.ts",
    "cleanup": "rimraf dist node_modules worker/dist",
    "example": "bun example/serve.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@oh-my-pi/pi-agent-core": "18.20.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/bun": "^1.4.4",
    "esbuild": "^0.25.0",
    "miniflare": "^4.20251011.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.3",
    "typescript": "^7"
  }
}
