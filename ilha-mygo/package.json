{
  "name": "ilha-mygo",
  "version": "0.1.0",
  "description": "Go retained-host bindings for ilha (bun:ffi primary, child-process IPC fallback)",
  "keywords": [
    "bun:ffi",
    "effect",
    "go",
    "ilha",
    "renderer"
  ],
  "homepage": "https://github.com/ilhajs/ilha#readme",
  "bugs": {
    "url": "https://github.com/ilhajs/ilha/issues"
  },
  "license": "MIT",
  "author": "Ryuz <ryuzer@proton.me>",
  "repository": {
    "type": "git+https://github.com/ilhajs/ilha.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./paint": {
      "types": "./dist/paint.d.ts",
      "import": "./dist/paint.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./catalogue": {
      "types": "./dist/catalogue.d.ts",
      "import": "./dist/catalogue.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:lib": "go build -o go/libmygo.so -buildmode=c-shared ./go/lib",
    "build:ipc": "go build -o bin/mygo-ipc ./go/cmd/mygo-ipc",
    "build": "tsdown",
    "cleanup": "rimraf dist node_modules",
    "example": "bun example/serve.ts",
    "example:build": "bun example/build.ts",
    "test": "bun run build:lib && bun run build:ipc && bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@typescript/typescript-linux-x64": "^7.0.2",
    "effect": "^4.1.0",
    "ilha": "file:../../ilha/packages/ilha",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.3",
    "typescript": "^7"
  },
  "peerDependencies": {
    "effect": "^4.1.0",
    "ilha": ">=0.16.3"
  }
}
